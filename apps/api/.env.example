# AI Notebook Studio API — server-side configuration only.
APP_ENV=development
DATABASE_URL=

# OIDC access-token verification. Never expose these settings to the browser.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALGORITHMS=RS256

# UGAI task integration. Keep disabled in local development until configured.
UGAI_ENABLED=false
UGAI_BASE_URL=https://ugai.example.test
UGAI_AUDIENCE=ugai-api
UGAI_TOKEN_ENDPOINT=https://identity.example.test/oauth/token
UGAI_CLIENT_ID=
UGAI_CLIENT_SECRET=
