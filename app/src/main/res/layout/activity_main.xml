<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1B">

    <TextView
        android:id="@+id/demo_mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7C2D12"
        android:padding="9dp"
        android:gravity="center"
        android:text="@string/demo_mode_notice"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/page_error_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="#152033"
            android:padding="18dp"
            android:gravity="center"
            android:text="@string/asset_load_error"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/docs_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="@string/open_docs"
            android:contentDescription="@string/open_docs" />
    </FrameLayout>
</LinearLayout>
